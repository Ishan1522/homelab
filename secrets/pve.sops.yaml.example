# Copy, fill, encrypt in place:
#   cp secrets/pve.sops.yaml.example secrets/pve.sops.yaml
#   $EDITOR secrets/pve.sops.yaml
#   sops -e -i secrets/pve.sops.yaml
# Afterwards edit with:  sops secrets/pve.sops.yaml
# Top-level keys become env vars under `sops exec-env` (that's how tofu reads them).
PROXMOX_VE_ENDPOINT: https://CHANGEME-pve:8006/
PROXMOX_VE_API_TOKEN: root@pam!tofu=CHANGEME-uuid
PROXMOX_VE_INSECURE: "true"   # self-signed cert on the host
# Only if the token gets refused on features/bind mounts (see tofu/README.md):
# PROXMOX_VE_USERNAME: root@pam
# PROXMOX_VE_PASSWORD: CHANGEME

# Not used by tooling yet; kept here so you stop resetting them.
SUNSHINE_CT201_USER: CHANGEME
SUNSHINE_CT201_PASS: CHANGEME
SUNSHINE_CT206_USER: CHANGEME
SUNSHINE_CT206_PASS: CHANGEME
